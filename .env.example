# Copy this file to .env and fill in real values. Never commit .env.
# All values below are placeholders.

# --- Application secrets (required only when ATLAS_MODE=live) ---
OPENAI_API_KEY=replace-with-your-openai-api-key
# Search credentials: live mode needs ONE of the two (Tavily or Exa).
TAVILY_API_KEY=replace-with-your-tavily-api-key
EXA_API_KEY=replace-with-your-exa-api-key

# Optional: an OpenAI-compatible endpoint (e.g. OpenRouter) instead of
# api.openai.com. Must be an http(s) URL; unset means the SDK default.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# --- Non-secret configuration ---
# "offline" (default) runs without any provider call.
# "live" requires OPENAI_API_KEY, ATLAS_MODEL, and one search key above.
ATLAS_MODE=offline

# No default is provided on purpose: no model ID is assumed or asserted by this
# project. Set it explicitly to a model your account can actually access before
# enabling live mode.
# ATLAS_MODEL=

ATLAS_MAX_ITERATIONS=8
ATLAS_MAX_RESULTS=5
ATLAS_TIMEOUT_SECONDS=30

# Hard wall-clock budget for one agent run. The loop stops and reports
# termination_reason="deadline_exceeded" when it is exhausted.
ATLAS_DEADLINE_SECONDS=120
