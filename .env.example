# Copy this file to .env and fill in real values. Never commit .env.
# All values below are placeholders.

# --- Application secrets (required only when ATLAS_MODE=live) ---
OPENAI_API_KEY=replace-with-your-openai-api-key
TAVILY_API_KEY=replace-with-your-tavily-api-key

# --- Non-secret configuration ---
# "offline" (default) runs without any provider call.
# "live" requires the two keys above and ATLAS_MODEL.
ATLAS_MODE=offline

# No default is provided on purpose: no model ID is assumed or asserted by this
# project. Set it explicitly to a model your account can actually access before
# enabling live mode.
# ATLAS_MODEL=

ATLAS_MAX_ITERATIONS=8
ATLAS_MAX_RESULTS=5
ATLAS_TIMEOUT_SECONDS=30

# Hard wall-clock budget for one agent run. The loop stops and reports
# termination_reason="deadline_exceeded" when it is exhausted.
ATLAS_DEADLINE_SECONDS=120
